# FlipFinder v1.0.0 configuration
# Required for AI semantic analysis and notification translation.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=qwen/qwen3.8-27b

# Required only when sending real Telegram alerts.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Local storage. A new SQLite database is created automatically on first run.
DATABASE_PATH=data/flip_finder.db
MARKET_PRICES_PATH=data/market_prices.json

# Optional network tuning. Leave HTTP_PROXY empty unless you explicitly use one.
HTTP_PROXY=
REQUEST_MIN_DELAY=2
REQUEST_MAX_DELAY=6
MAX_CONCURRENT_REQUESTS=2
REQUEST_TIMEOUT=30

# Monitoring and marketplace profile defaults.
SEARCH_QUERIES=iPhone 13,iPhone 14,iPhone 15,iPhone 16
SEARCH_MAX_PAGES=3
MAX_BUY_PRICE_PLN=5000
MIN_SANITY_PRICE_PLN=100
MARKET_LOOKBACK_HOURS=72
MONITOR_INTERVAL_MINUTES=15
AI_REQUEST_DELAY_SECONDS=4

# Production scoring thresholds.
MIN_FLIP_SCORE=70
MIN_MARGIN_PCT=15
MAX_FRAUD_RISK=0.3
MARKETPLACE_FEE_PCT=0

# Logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
